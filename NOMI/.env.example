# Copy to .env (python setup.py does it for you) and add your key.
# Get one at https://console.anthropic.com — usage is billed to that account.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# JARVIS_MODEL=claude-sonnet-5-5   # model for normal messages
# JARVIS_MAX_TOKENS=2048           # longest answer
# JARVIS_LANG=en-US                # speech recognition language, e.g. mn-MN
# NOMI_HOME=~/.nomi                # where memory and settings are saved
# NOMI_DASHBOARD_PORT=8000         # phone dashboard port
# NOMI_DEBUG=1                     # extra logging
